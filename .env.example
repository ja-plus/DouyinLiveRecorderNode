# ============================================================
#  LiveRecorder-node Docker Compose 环境变量
#  复制此文件为 .env 并按需修改：cp .env.example .env
# ============================================================

# Web 管理台对外端口（默认 5000）
MANAGER_PORT=5000

# 录制器状态服务对外端口（默认 5001）
RECORDER_STATUS_PORT=5001

# 录制文件保存目录（宿主机路径，默认 ./downloads）
# 可改为绝对路径如 /data/recordings
DOWNLOADS_DIR=./downloads
