{
  "name": "live-recorder-node",
  "version": "4.0.7",
  "description": "Live stream recorder - Node.js implementation",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "node --max-semi-space-size=4 --max-old-space-size=256 main.js",
    "bun:start": "bun main.js",
    "dev": "node --watch main.js",
    "build:config-manager": "tsc -p config-manager/tsconfig.json",
    "dev:config-manager-frontend": "vite --config config-manager/frontend/vite.config.ts config-manager/frontend",
    "build:config-manager-frontend": "vue-tsc --noEmit -p config-manager/frontend/tsconfig.json && vite build --config config-manager/frontend/vite.config.ts config-manager/frontend",
    "preview:config-manager-frontend": "vite preview --config config-manager/frontend/vite.config.ts config-manager/frontend",
    "config-manager": "node config-manager/dist/server.js",
    "bun:config-manager": "bun --cwd config-manager server.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.57.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.1.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-fastify": "^11.1.6",
    "fastify": "^5.3.3",
    "hpagent": "^1.2.0",
    "ini": "^5.0.0",
    "ja-fetch": "^1.6.1",
    "mpegts.js": "^1.8.0",
    "nodemailer": "^7.0.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "stk-table-vue": "^1.0.2",
    "undici": "^7.8.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/ini": "^4.1.1",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^6.0.3",
    "unplugin-vue-components": "^0.28.0",
    "vite": "^6.0.7",
    "vue-tsc": "^3.3.8"
  },
  "license": "MIT",
  "packageManager": "pnpm@8.15.1+sha1.8adba2d20330c02d3856e18c4eb3819d1d3ca6aa"
}